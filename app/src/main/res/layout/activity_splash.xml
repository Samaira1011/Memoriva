<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSplashBackground">

    <!-- Center content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Logo placeholder (no CardView dependency issues) -->
        <ImageView
            android:id="@+id/cardLogo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_launcher_foreground"
            android:background="@color/colorPrimary"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="@string/app_name" />

        <!-- App name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="44sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginTop="20dp" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tagline"
            android:textSize="15sp"
            android:textColor="@color/colorTextPrimary"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="4dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/colorPrimary"
            android:progressBackgroundTint="@color/colorDivider"
            android:layout_marginTop="36dp" />

        <!-- Reliving label -->
        <TextView
            android:id="@+id/tvReliving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reliving_journey"
            android:textSize="12sp"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginTop="12dp" />

    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/tvFooter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/designed_for_explorers"
        android:textSize="11sp"
        android:textColor="@color/colorTextPrimary"
        android:letterSpacing="0.1"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp" />

</FrameLayout>
