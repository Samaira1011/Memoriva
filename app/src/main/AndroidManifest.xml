<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" /> <!-- Location permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" /> <!-- Camera permission -->
    <uses-permission android:name="android.permission.CAMERA" /> <!-- Media/storage permissions -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <!-- READ_MEDIA_IMAGES for API 33+ -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" /> <!-- READ_EXTERNAL_STORAGE for API < 33 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" /> <!-- WRITE_EXTERNAL_STORAGE for API <= 28 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" /> <!-- Notification permissions -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MemorivaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Memoriva">
        <activity
            android:name=".MainActivity"
            android:exported="false">
        </activity>
        <!-- Google Maps API Key -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="YOUR_MAPS_API_KEY" /> <!-- Splash Activity - LAUNCHER -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Authentication Activities -->
        <activity
            android:name=".SignInActivity"
            android:exported="false"
            android:theme="@style/Theme.Memoriva.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:theme="@style/Theme.Memoriva.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.Memoriva.Auth"
            android:windowSoftInputMode="adjustResize" /> <!-- Map Activity - home screen with bottom navigation -->
        <activity
            android:name=".MapActivity"
            android:exported="false" />
        <activity
            android:name=".WorldMapActivity"
            android:exported="false" /> <!-- Base Activity (abstract, no registration needed) -->
        <!-- Calendar Activity -->
        <activity
            android:name=".CalendarActivity"
            android:exported="false" /> <!-- Memory Activities -->
        <activity
            android:name=".MemoryCreateEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MemoryDetailActivity"
            android:exported="false" />
        <activity
            android:name=".MemoryListActivity"
            android:exported="false" /> <!-- Trip Activities -->
        <activity
            android:name=".TripCreateEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MyTripsActivity"
            android:exported="false" />
        <activity
            android:name=".TripTimelineActivity"
            android:exported="false" />
        <activity
            android:name=".TripDetailActivity"
            android:exported="false" /> <!-- Dream Board Activities -->
        <activity
            android:name=".DreamBoardActivity"
            android:exported="false" />
        <activity
            android:name=".DreamDestinationCreateEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DreamDestinationDetailActivity"
            android:exported="false" /> <!-- Profile Activity -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" /> <!-- Time Capsule Activity -->
        <activity
            android:name=".TimeCapsuleActivity"
            android:exported="false" /> <!-- Place Detail Activity -->
        <activity
            android:name=".PlaceDetailActivity"
            android:exported="false" /> <!-- Review Create/Edit Activity -->
        <activity
            android:name=".ReviewCreateEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" /> <!-- Travel Stats Activity -->
        <activity
            android:name=".TravelStatsActivity"
            android:exported="false" /> <!-- Friends Discover Activity -->
        <activity
            android:name=".FriendsDiscoverActivity"
            android:exported="false" /> <!-- On This Day Activity -->
        <activity
            android:name=".OnThisDayActivity"
            android:exported="false" /> <!-- On This Day BroadcastReceiver -->
        <receiver
            android:name=".OnThisDayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.memoriva.ON_THIS_DAY" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver> <!-- FileProvider for camera capture and file sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.example.memoriva.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
